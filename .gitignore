# Tools, generated builds, devices and private work stay local.
.tools/
build/
dist/
private/
.gradle/
**/build/
__pycache__/
*.pyc
local.properties
.env
.env.*
.codex/
.agents/

# Never commit user games, BIOS, saves, signing keys or compiled programs.
*.iso
*.ISO
*.bin
*.BIN
*.cue
*.CUE
*.chd
*.CHD
*.img
*.IMG
*.ccd
*.sub
*.mcr
*.state
*.sav
*.srm
*.keystore
*.jks
*.p12
*.key
*.pem
*.apk
*.aab
*.so
*.dll
*.exe
*.zip
*.7z
*.rar
*.pbp
*.PBP
*.rom
*.ROM
*.bios
*.mdf
*.mds
*.ecm
*.cso
*.dmp
